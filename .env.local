# ==========================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION (.local)
# ==========================================
# Rename to .env for local development
# Used by default by 'docker-compose up'

# --- API Configuration ---
DEMETER_ENV=development
API_PREFIX=/api
# In local, debug mode enables verbose logging and Swagger/Redoc
DEBUG=True

# --- Database Credentials (Local Dev) ---
DEMETER_POSTGRES_USER=postgres
DEMETER_POSTGRES_PASSWORD=postgres_local_pass
DEMETER_POSTGRES_DB=demeter_dev

# --- Raspberry Pi Hardware ---
# Leave default or mock for local development
SERIAL_PORT_HOST=/dev/ttyS0

# --- Frontend Settings ---
# URL where the frontend expects to find the API
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
