# ── Stage 1: Build React (always on native arch, output is static) ───────
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder
WORKDIR /app

# Enable injection of API URLs at build time
ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}

# Install dependencies (cached if package*.json unchanged)
COPY Software/Servidor/Frontend/Demeter-React/package*.json ./
RUN npm ci

# Copy sources and build
COPY Software/Servidor/Frontend/Demeter-React ./
RUN npm run build

# ── Stage 2: Serve with Nginx (target platform, e.g. arm64) ─────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY Software/Servidor/Backend/Nginx/nginx.rpi.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
