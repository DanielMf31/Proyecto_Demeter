{
  "compilerOptions": {
    // File layout
    "rootDir": "./Software/Servidor/Frontend/Web/src",
    "outDir": "./Software/Servidor/Frontend/Web/dist",
    // Target: modern browsers (esbuild handles transpilation)
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    // Outputs (used by tsc --noEmit for typecheck only)
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "Software/Servidor/Frontend/Web/src/**/*"
  ]
}