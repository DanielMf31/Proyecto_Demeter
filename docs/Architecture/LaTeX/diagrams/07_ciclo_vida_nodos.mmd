flowchart TD
    A([Inicio]) --> B[Tipo de Nodo\ndefinido en compilación]
    B --> C{Rol}
    C -- SENSOR --> S1[Inicializar periféricos\nDHT22 DS18B20 Suelo]
    C -- ACTUATOR --> A1[Inicializar pines\nde salida y relés]
    C -- GATEWAY --> G1[Inicializar UART\n+ ESP-NOW]

    S1 --> S2[Registrar MAC\ndel Gateway]
    S2 --> S3[Handshake con Gateway]
    S3 --> S4{Handshake OK?}
    S4 -- No/Timeout --> S5{Reintentos < 3?}
    S5 -- Si --> S3
    S5 -- No --> S6[Estado: IDLE\nesperando]
    S4 -- Si --> S7[Estado: RUNNING]
    S7 --> S8[Bucle: leer sensores\ny reportar cada 5s]
    S8 --> S7

    A1 --> A2[Registrar MAC\ndel Gateway]
    A2 --> A3[Bucle: escuchar\ncomandos SET_GPIO]
    A3 --> A4[Ejecutar pin\ny enviar PIN_REPORT]
    A4 --> A3

    G1 --> G2[Registrar MACs\nde nodos conocidos]
    G2 --> G3[Bucle: escuchar\nRF y UART]
    G3 --> G4[Reenviar trama\nal canal opuesto]
    G4 --> G3
