flowchart TD
    A[Trama recibida] --> B{SYNC valido?}
    B -- No --> D1[Descartar\nsin notificar]
    B -- Si --> C{LENGTH coherente?}
    C -- No --> D2[Descartar\nsin notificar]
    C -- Si --> E{CRC correcto?}
    E -- No --> D3[Descartar\nRegistrar CRC Error en log]
    E -- Si --> F{DST_ID correcto?}
    F -- No soy yo --> G{Gateway?}
    G -- Si --> H[Reenviar integra\nal canal alternativo]
    G -- No --> D4[Ignorar]
    F -- Si --> I{CMD_ID conocido?}
    I -- No --> D5[Descartar\nRegistrar Unknown CMD]
    I -- Si --> J{Payload tiene\ntamaño esperado?}
    J -- No --> K[Enviar NACK\nal emisor]
    J -- Si --> L{Nodo en\nestado valido?}
    L -- ERROR o BOOT --> M[Ignorar\nNo se procesa]
    L -- IDLE o RUNNING --> N[Ejecutar handler\ncorrespondiente]
