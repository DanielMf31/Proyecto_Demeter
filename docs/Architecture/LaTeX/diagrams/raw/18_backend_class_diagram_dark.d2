# ═══════════════════════════════════════════════════════════════════
#  DATABASE MODELS (SQLAlchemy ORM)
# ═══════════════════════════════════════════════════════════════════

Models: "BD/models.py — SQLAlchemy ORM" {
  style: {
    fill: "#ffffff"
    stroke: "#3fb950"
    stroke-width: 2
    border-radius: 14
    font-color: "#1a7f37"
    font-size: 15
    bold: true
  }

  User: {
    class: model
    label: |md
      # User
      ---
      id: UUID (PK)
      username: String (unique)
      password_hash: String
      role: String
      is_active: Boolean
      ---
      → sequences[]
      → activity_logs[]
      → experiments[]
    |
  }

  Device: {
    class: model
    label: |md
      # Device
      ---
      id: Integer (PK)
      name: String
      device_type: String
      gpio_pin: Integer
      ---
      → sequence_steps[]
      → activity_logs[]
    |
  }

  Sequence: {
    class: model
    label: |md
      # Sequence
      ---
      id: Integer (PK)
      name: String
      created_by: UUID (FK → User)
      created_at: DateTime
      ---
      → creator: User
      → steps[] (cascade)
    |
  }

  SequenceStep: {
    class: model
    label: |md
      # SequenceStep
      ---
      id: Integer (PK)
      sequence_id: FK → Sequence
      device_id: FK → Device
      step_order: Integer
      target_state: Boolean
      duration_seconds: Integer
    |
  }

  ActivityLog: {
    class: model
    label: |md
      # ActivityLog
      ---
      id: Integer (PK)
      timestamp: DateTime
      user_id: FK → User (nullable)
      device_id: FK → Device (nullable)
      action_type: String
      description: Text
    |
  }

  # ── LIMS ──
  Experiment: {
    class: model
    label: |md
      # Experiment
      ---
      id: Integer (PK)
      name · description: String
      created_at: DateTime
      user_id: FK → User
      api_key: String (unique)
      ---
      → user: User
      → plants[] (M:N)
    |
  }

  Plant: {
    class: model
    label: |md
      # Plant
      ---
      id: Integer (PK)
      name: String
      identificador_fisico: String
      especie_variedad: String
      fecha_siembra: Date
      estado_vital: String
      metadata_cientifica: JSONB
      node_id: Integer (unique)
      ---
      → experiments[] (M:N)
    |
  }

  ExperimentoPlantaLink: {
    class: model
    label: |md
      # ExperimentoPlantaLink
      ---
      experiment_id: FK (PK)
      plant_id: FK (PK)
      linked_at: DateTime
    |
  }

  # ── Telemetry ──
  TelemetryTH: {
    class: model
    label: |md
      # TelemetryTH
      ---
      id (PK) · timestamp (idx)
      node_id (idx)
      temperature: Float
      humidity: Float
    |
  }

  PinHistory: {
    class: model
    label: |md
      # PinHistory
      ---
      id (PK) · timestamp (idx)
      node_id (idx)
      pin: Integer
      state: Boolean
    |
  }

  SystemHistory: {
    class: model
    label: |md
      # SystemHistory
      ---
      id (PK) · timestamp (idx)
      node_id (idx)
      mode: Integer
      battery_mv: Integer
    |
  }

  # ── Relaciones ORM ──
  Sequence -> User: "created_by" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  SequenceStep -> Sequence: "sequence_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  SequenceStep -> Device: "device_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  ActivityLog -> User: "user_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  ActivityLog -> Device: "device_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  Experiment -> User: "user_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  ExperimentoPlantaLink -> Experiment: "experiment_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
  ExperimentoPlantaLink -> Plant: "plant_id" {style.stroke: "#3fb950"; style.stroke-dash: 4}
}

# ═══════════════════════════════════════════════════════════════════
#  PYDANTIC SCHEMAS (BD/schemas.py)
