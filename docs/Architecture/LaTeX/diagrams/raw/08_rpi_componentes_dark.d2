# ── Actores externos ───────────────────────────────────────────────

ESP32: "Gateway ESP32\n(Red Local Demeter)" {class: external}
Backend: "Backend Central\n(FastAPI · PostgreSQL)" {class: external}
LocalUI: "UI Local\n(Nginx :80 · Chromium)" {class: external}

# ── Capa de Borde (Raspberry Pi) ──────────────────────────────────

RPi: "Capa de Borde — Servicio Python en Raspberry Pi" {
  style: {
    fill: "#f6f8fa"
    stroke: "#e3b341"
    stroke-width: 3
    border-radius: 16
    font-color: "#9a6700"
    font-size: 16
    bold: true
  }

  EdgeServer: "EdgeServer (FastAPI)\nedge_server.py · :8001" {class: edge}
  Orchestrator: "GatewayOrchestrator\ncommand_dispatcher.py" {class: orchestrator}
  UART: "AsyncUART\nasync_uart.py" {class: internal}
  Processor: "UARTProcessor\nuart_processor.py" {class: internal}
  DevManager: "DeviceManager\n(Tabla de Estado Local)" {class: internal}
  WSClient: "WebSocketClient\nws_client.py" {class: internal}

  # ── Flujo ascendente: datos desde UART hacia el orquestador ──
  UART -> Processor: "Tramas binarias" {
    style.stroke: "#388bfd"
    style.font-color: "#0550ae"
    style.bold: true
  }
  Processor -> UART: "Comandos binarios" {
    style.stroke: "#388bfd"
    style.font-color: "#0550ae"
    style.stroke-dash: 4
  }
  Processor -> Orchestrator: "listener callback\n(telemetría · eventos)" {
    style.stroke: "#3fb950"
    style.font-color: "#1a7f37"
    style.bold: true
  }

  # ── Flujo desde el orquestador hacia los demás componentes ──
  Orchestrator -> DevManager: "Actualiza estado" {
    style.stroke: "#e3b341"
    style.font-color: "#9a6700"
  }
  Orchestrator -> WSClient: "dispatch_uart_to_ws()\nPublica eventos" {
    style.stroke: "#3fb950"
    style.font-color: "#1a7f37"
    style.bold: true
  }

  # ── Flujo descendente: órdenes del backend ──
  WSClient -> Orchestrator: "dispatch_ws_to_uart()\nRecibe órdenes" {
    style.stroke: "#d2a8ff"
    style.font-color: "#6639ba"
    style.bold: true
  }
  Orchestrator -> Processor: "send()\nSolicita envío" {
    style.stroke: "#d2a8ff"
    style.font-color: "#6639ba"
  }

  # ── EdgeServer wraps Orchestrator ──
  EdgeServer -> Orchestrator: "POST /api/command\nComandos locales" {
    style.stroke: "#58a6ff"
    style.font-color: "#0550ae"
    style.bold: true
  }
}

