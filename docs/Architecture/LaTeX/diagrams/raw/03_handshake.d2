
# ─────────────────────────────────────────────────────────────────
#  Protocolo Demeter – Handshake de Sesión (SYN / SYN-ACK / ACK)
#  Nota: D2 usa `sequence_diagram` shape en lugar de sequenceDiagram
# ─────────────────────────────────────────────────────────────────

shape: sequence_diagram

# ── Participantes ─────────────────────────────────────────────────

N: "Nodo\n(Sensor / Actuador)" {
  style: {
    fill: "#21262d"
    stroke: "#388bfd"
    font-color: "#e6edf3"
    bold: true
  }
}

G: "Gateway" {
  style: {
    fill: "#0f2d24"
    stroke: "#3fb950"
    font-color: "#3fb950"
    bold: true
  }
}

# ── Secuencia: flujo exitoso ──────────────────────────────────────

N -> N: "Estado: IDLE" {
  style.stroke: "#6e7681"
  style.font-color: "#8b949e"
  style.stroke-dash: 4
}

N -> G: "SYN  (CMD=0x04, sin payload)" {
  style.stroke: "#388bfd"
  style.font-color: "#58a6ff"
  style.bold: true
}

N -> N: "Estado: HANDSHAKE_WAIT_SYN_ACK\nInicia temporizador 2000 ms" {
  style.stroke: "#e3b341"
  style.font-color: "#e3b341"
  style.stroke-dash: 4
}

G -> N: "SYN-ACK  (CMD=0x05, sin payload)" {
  style.stroke: "#3fb950"
  style.font-color: "#3fb950"
  style.bold: true
}

N -> N: "Temporizador cancelado" {
  style.stroke: "#6e7681"
  style.font-color: "#8b949e"
  style.stroke-dash: 4
}

N -> G: "ACK  (CMD=0x02, payload: Contexto de sesión)" {
  style.stroke: "#388bfd"
  style.font-color: "#58a6ff"
  style.bold: true
}

N -> N: "Estado: RUNNING ✓" {
  style.stroke: "#3fb950"
  style.font-color: "#3fb950"
  style.bold: true
}

G -> G: "Sesión establecida" {
  style.stroke: "#3fb950"
  style.font-color: "#3fb950"
}

# ── Secuencia: timeout / reintentos ──────────────────────────────

N -> N: "TIMEOUT — Intento 1/3 fallido → Reintento" {
  style.stroke: "#f85149"
  style.font-color: "#f85149"
  style.stroke-dash: 4
}

N -> G: "SYN  (reintento 1)" {
  style.stroke: "#e3b341"
  style.font-color: "#e3b341"
  style.bold: true
}

N -> N: "TIMEOUT — Intento 2/3 fallido → Reintento" {
  style.stroke: "#f85149"
  style.font-color: "#f85149"
  style.stroke-dash: 4
}

N -> G: "SYN  (reintento final 2)" {
  style.stroke: "#e3b341"
  style.font-color: "#e3b341"
  style.bold: true
}

N -> N: "TIMEOUT — Estado: IDLE\n(3 intentos agotados)" {
  style.stroke: "#f85149"
  style.font-color: "#f85149"
  style.bold: true
}
