# AUTO-GENERADO por make_print.py — VERSIÓN PARA IMPRESIÓN
# Colores adaptados para fondo blanco / documento académico
# No editar directamente; editar el archivo fuente y regenerar.


# ─────────────────────────────────────────────────────────────────
#  Protocolo Demeter – Handshake de Sesión (SYN / SYN-ACK / ACK)
#  Nota: D2 usa `sequence_diagram` shape en lugar de sequenceDiagram
# ─────────────────────────────────────────────────────────────────

shape: sequence_diagram

# ── Participantes ─────────────────────────────────────────────────

N: "Nodo\n(Sensor / Actuador)" {
  style: {
    fill: "#ffffff"
    stroke: "#388bfd"
    font-color: "#1a1a2e"
    bold: true
  }
}

G: "Gateway" {
  style: {
    fill: "#dff7eb"
    stroke: "#3fb950"
    font-color: "#1a7f37"
    bold: true
  }
}

# ── Secuencia: flujo exitoso ──────────────────────────────────────

N -> N: "Estado: IDLE" {
  style.stroke: "#6e7681"
  style.font-color: "#4a4a5a"
  style.stroke-dash: 4
}

N -> G: "SYN  (CMD=0x04, sin payload)" {
  style.stroke: "#388bfd"
  style.font-color: "#0550ae"
  style.bold: true
}

N -> N: "Estado: HANDSHAKE_WAIT_SYN_ACK\nInicia temporizador 2000 ms" {
  style.stroke: "#e3b341"
  style.font-color: "#9a6700"
  style.stroke-dash: 4
}

G -> N: "SYN-ACK  (CMD=0x05, sin payload)" {
  style.stroke: "#3fb950"
  style.font-color: "#1a7f37"
  style.bold: true
}

N -> N: "Temporizador cancelado" {
  style.stroke: "#6e7681"
  style.font-color: "#4a4a5a"
  style.stroke-dash: 4
}

N -> G: "ACK  (CMD=0x02, payload: Contexto de sesión)" {
  style.stroke: "#388bfd"
  style.font-color: "#0550ae"
  style.bold: true
}

N -> N: "Estado: RUNNING ✓" {
  style.stroke: "#3fb950"
  style.font-color: "#1a7f37"
  style.bold: true
}

G -> G: "Sesión establecida" {
  style.stroke: "#3fb950"
  style.font-color: "#1a7f37"
}

# ── Secuencia: timeout / reintentos ──────────────────────────────

N -> N: "TIMEOUT — Intento 1/3 fallido → Reintento" {
  style.stroke: "#f85149"
  style.font-color: "#cf222e"
  style.stroke-dash: 4
}

N -> G: "SYN  (reintento 1)" {
  style.stroke: "#e3b341"
  style.font-color: "#9a6700"
  style.bold: true
}

N -> N: "TIMEOUT — Intento 2/3 fallido → Reintento" {
  style.stroke: "#f85149"
  style.font-color: "#cf222e"
  style.stroke-dash: 4
}

N -> G: "SYN  (reintento final 2)" {
  style.stroke: "#e3b341"
  style.font-color: "#9a6700"
  style.bold: true
}

N -> N: "TIMEOUT — Estado: IDLE\n(3 intentos agotados)" {
  style.stroke: "#f85149"
  style.font-color: "#cf222e"
  style.bold: true
}
