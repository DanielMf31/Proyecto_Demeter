flowchart TD
    %% Título: Arquitectura de Componentes del Servicio Raspberry (Capa de Borde)
    
    %% Nodos externos
    ESP32[("📡 Gateway ESP32\n(Red Local Demeter)")]
    Backend[("☁️ Backend Central\n(FastAPI / PostgreSQL)")]
    
    subgraph RPi["Capa de Borde (Servicio Python en Raspberry Pi)"]
        direction TB
        
        %% Componentes de la RPi
        UART["🔌 Async UART\n(async_uart.py)"]
        Processor["⚙️ UART Processor\n(uart_processor.py)"]
        Service["👑 Async Service\n(Orquestador Principal)"]
        DevManager["📇 Device Manager\n(Tabla de Estado Local)"]
        CmdDispatcher["🎯 Command Dispatcher\n(command_dispatcher.py)"]
        WSClient["🌐 WebSocket Client\n(ws_client)"]
        
        %% Relaciones internas
        UART -->|Tramas Binarias| Processor
        Processor -->|Comandos Binarios| UART
        Processor -->|Eventos Telemetría| Service
        Service -->|Actualiza Estado| DevManager
        Service -->|Publica Eventos| WSClient
        WSClient -->|Recibe Órdenes| CmdDispatcher
        CmdDispatcher -->|Solicita Envío| UART
    end
    
    %% Relaciones externas
    ESP32 -->|/dev/serial0| UART
    UART -->|/dev/serial0| ESP32
    WSClient -->|wss:// JSON| Backend
    Backend -->|wss:// JSON| WSClient
    
    %% Estilos
    classDef external fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef core fill:#e1f5fe,stroke:#0277bd,stroke-width:2px;
    
    class ESP32,Backend external;
    class UART,Processor,Service,DevManager,CmdDispatcher,WSClient core;
