classDiagram
    class DemeterProtocolV2 {
        -Logger logger
        -Dict registry
        +serialize(cmd: DemeterCommand) : bytes
        +parse_frame(frame_bytes: bytes) : Optional~DemeterCommand~
        -_calculate_crc(data) : int
        -_pack_frame_raw(...) : bytes
        -_parse_ping(...)
        -_parse_ack(...)
        -_parse_set_gpio(...)
        -_parse_temp_hum_report(...)
    }

    class DemeterCommand {
        <<Abstract>>
        +int target_id
        +int cmd_id
        +get_cmd_id()
    }

    %% Commands
    class Ping { +get_cmd_id() }
    class SetGpio { 
        +int pin
        +int value
        +int flags
    }
    class SetPwm { 
        +int pin
        +int value 
    }
    class ExecSequence { 
        +List~SequenceStep~ steps 
    }
    class SequenceStep {
        +int target_id
        +int cmd_id
        +int pin
        +int value
        +int delay_ms
    }

    %% Responses
    class Ack { 
        +int original_cmd_id 
    }
    class Nack { 
        +int original_cmd_id
        +int error_code 
    }

    %% Reports
    class TempHumReport {
        +int node_id
        +float temperature
        +float humidity
    }
    class PinReport {
        +int node_id
        +int pin
        +int state
    }
    class SystemReport {
        +int node_id
        +int mode
        +int battery_mv
    }

    %% Relationships
    DemeterProtocolV2 ..> DemeterCommand : uses
    DemeterCommand <|-- Ping
    DemeterCommand <|-- SetGpio
    DemeterCommand <|-- SetPwm
    DemeterCommand <|-- ExecSequence
    DemeterCommand <|-- Ack
    DemeterCommand <|-- Nack
    DemeterCommand <|-- TempHumReport
    DemeterCommand <|-- PinReport
    DemeterCommand <|-- SystemReport

    ExecSequence o-- SequenceStep : contains
