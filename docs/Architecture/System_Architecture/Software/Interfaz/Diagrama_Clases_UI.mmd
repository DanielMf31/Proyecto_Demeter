classDiagram
    %% Core Identity
    class DemeterApp {
        +DemeterViewModel vm
        +start_async_loop()
        +trigger_command(pin, action)
        +trigger_ping(target_id)
        +trigger_get_sensors(target_id)
        +trigger_sequence_payload(steps_data)
        +on_data_received(report)
        +on_closing()
    }

    class DemeterViewModel {
        -asyncio.Loop loop
        -StreamReader reader
        -StreamWriter writer
        -bool connected
        +connect()
        +send_command(pin, action)
        +send_ping(target_id)
        +send_get_sensors(target_id)
        +send_sequence(steps, target_id)
        +save_sequence_file(filename, steps)
        +load_sequence_file(filename)
        +shutdown()
        -handle_response(data)
    }

    %% Views
    class SidebarFrame {
        +update_status(connected: bool)
    }

    class ControlPanelFrame {
        -Callable command_callback
        +create_actuator_card()
        +create_pump_card()
        +update_actuator_state(state, battery)
        +on_ping()
        +on_get_data()
    }

    class SequencePlannerFrame {
        -List steps
        +add_step()
        +clear_steps()
        +refresh_preview()
        +save_sequence()
        +load_sequence()
        +run_sequence()
    }

    class LogConsoleFrame {
        +append_log(text: str)
    }

    %% Relationships
    DemeterApp *-- DemeterViewModel : Composes
    DemeterApp *-- SidebarFrame : Contains
    DemeterApp *-- ControlPanelFrame : Contains
    DemeterApp *-- SequencePlannerFrame : Contains
    DemeterApp *-- LogConsoleFrame : Contains

    %% Associations (Callbacks/Interactions)
    ControlPanelFrame ..> DemeterApp : triggers commands via callback
    SequencePlannerFrame ..> DemeterViewModel : uses for file I/O
