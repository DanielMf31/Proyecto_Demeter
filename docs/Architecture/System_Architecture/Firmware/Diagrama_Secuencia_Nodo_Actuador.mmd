sequenceDiagram
    participant Gateway
    participant Engine as ProtocolEngine
    participant Actuator as NodoActuador (ID 3)
    participant Relay as GPIO Pin 2

    %% --- Setup ---
    Actuator->>Engine: Register Callbacks (onSetGpio)
    Actuator->>Actuator: Loop (Active Listening)

    %% --- Command Reception ---
    Gateway->>Engine: ESP-NOW Frame (SET_GPIO, Pin=2, Val=1)
    activate Engine
    Engine->>Engine: Parse & Validate CRC
    Engine->>Actuator: Callback: onSetGpio(Pin=2, Val=1)
    deactivate Engine
    
    activate Actuator
    Actuator->>Relay: digitalWrite(HIGH)
    Relay-->>Actuator: State Changed
    
    %% --- Feedback ---
    Actuator->>Engine: sendPinReport(Target=1, Pin=2, State=1)
    Engine->>Gateway: ESP-NOW Frame (PIN_REPORT)
    
    Actuator->>Engine: sendSystemReport(Target=1, Batt=12.5V)
    Engine->>Gateway: ESP-NOW Frame (SYSTEM_REPORT)
    deactivate Actuator
