direction: right
vars: {
  d2-config: {
    layout-engine: dagre
  }
}
style: {
  stroke: "#2b6cb0"
  fill: "white"
}

title: Diagrama C4 Nivel 3 - Componentes (Raspberry Pi Gateway)

"Nodos ESP32": {
  shape: rectangle
  style: { fill: "#e9c46a" }
  description: "Sensores y Actuadores de Malla"
}

"Raspberry Pi (Gateway)": {
  style: {
    fill: "#ebf8ff"
    stroke: "#2b6cb0"
    stroke-dash: 5
    stroke-width: 2
  }

  "Lector Serial (UART)": {
    shape: rectangle
    description: "Lee tramas binarias seriales del nodo coordinador (Gateway Bridge)"
  }

  "Motor de Protocolo": {
    shape: rectangle
    description: "Parsea, valida y decodifica las tramas a estructuras lógicas (Python)"
  }

  "Control Físico (GPIO/Local)": {
    shape: rectangle
    description: "Lógica de accionamiento de relés de bombas/válvulas locales"
  }

  "Cliente WebSocket / Interfaz API": {
    shape: rectangle
    description: "Canal bidireccional TCP con el Servidor Central"
  }
}

"Demeter API (FastAPI)": {
  shape: rectangle
  style: { fill: "#264653"; font-color: white }
  description: "Backend Central"
}

# Flujos Internos de Componentes
"Nodos ESP32" -> "Raspberry Pi (Gateway)"."Lector Serial (UART)": "Tráfico de telemetría (Radio/Serial)"

"Raspberry Pi (Gateway)"."Lector Serial (UART)" -> "Raspberry Pi (Gateway)"."Motor de Protocolo": "Tramas en Bytes"
"Raspberry Pi (Gateway)"."Motor de Protocolo" -> "Raspberry Pi (Gateway)"."Control Físico (GPIO/Local)": "Secuencias y Actuación Física"
"Raspberry Pi (Gateway)"."Motor de Protocolo" -> "Raspberry Pi (Gateway)"."Cliente WebSocket / Interfaz API": "Telemetría parseada (Diccionarios)"

"Raspberry Pi (Gateway)"."Cliente WebSocket / Interfaz API" -> "Demeter API (FastAPI)": "Publica datos JSON en vivo (wss://)"
"Demeter API (FastAPI)" -> "Raspberry Pi (Gateway)"."Cliente WebSocket / Interfaz API": "Desbloqueos o Comandos (RPC) a los Nodos"
