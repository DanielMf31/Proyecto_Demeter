direction: right
vars: {
  d2-config: {
    layout-engine: dagre
  }
}
style: {
  stroke: "#2b6cb0"
  fill: "white"
}

title: Diagrama C4 Nivel 3 - Componentes (Servidor FastAPI)

"Demeter React (Frontend)": {
  shape: rectangle
  style: { fill: "#2a9d8f"; font-color: white }
  description: "Cliente Web"
}

"Demeter API (FastAPI)": {
  style: {
    fill: "#ebf8ff"
    stroke: "#2b6cb0"
    stroke-dash: 5
    stroke-width: 2
  }
  
  "API Routers": {
    style: { fill: transparent; stroke-dash: 5 }
    
    "Auth Router": {
      shape: rectangle
      description: "Gestiona Login, Registro y validación JWT"
    }
    
    "Export Router": {
      shape: rectangle
      description: "Gestiona peticiones de exportación y polling"
    }
  }

  "Core Services": {
    style: { fill: transparent; stroke-dash: 5 }
    
    "Auth Service": {
      shape: rectangle
      description: "Lógica de encriptación (bcrypt) y firma de tokens"
    }
    
    "Task Service": {
      shape: rectangle
      description: "Wrapper para encolar trabajos en Redis Queue"
    }
  }

  "Data Access Layer": {
    style: { fill: transparent; stroke-dash: 5 }
    
    "User Repository": {
      shape: rectangle
      description: "Operaciones CRUD sobre usuarios (SQLAlchemy)"
    }
  }
}

"Redis (DB 1)": {
  shape: queue
  style: { fill: "#d62828"; font-color: white }
  description: "Cola de Tareas RQ"
}

"PostgreSQL": {
  shape: cylinder
  style: { fill: "#0077b6"; font-color: white }
  description: "Base de Datos"
}


# ------------------------------------------------------------------
# RELACIONES ENTRE COMPONENTES URBANOS
# ------------------------------------------------------------------

# Flujo de Autenticación
"Demeter React (Frontend)" -> "Demeter API (FastAPI)"."API Routers"."Auth Router": "POST /api/auth/login"
"Demeter API (FastAPI)"."API Routers"."Auth Router" -> "Demeter API (FastAPI)"."Core Services"."Auth Service": "Verifica credenciales"
"Demeter API (FastAPI)"."Core Services"."Auth Service" -> "Demeter API (FastAPI)"."Data Access Layer"."User Repository": "Busca usuario por email/username"
"Demeter API (FastAPI)"."Data Access Layer"."User Repository" -> "PostgreSQL": "Consulta SQL"

# Flujo de Exportación
"Demeter React (Frontend)" -> "Demeter API (FastAPI)"."API Routers"."Export Router": "POST /api/export/plants"
"Demeter API (FastAPI)"."API Routers"."Export Router" -> "Demeter API (FastAPI)"."Core Services"."Task Service": "Solicita trabajo encolado"
"Demeter API (FastAPI)"."Core Services"."Task Service" -> "Redis (DB 1)": "Publica Hash del Job"
