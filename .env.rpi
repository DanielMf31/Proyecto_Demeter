# ==========================================
# RASPBERRY PI — Variables de Entorno
# ==========================================
# Copia este fichero a .env en la Raspberry y ajusta los valores.
# NUNCA committear este fichero con datos reales.

# ── Entorno ──────────────────────────────────────────────────────────────────
DEMETER_ENV=production
DEMETER_DEBUG=false
DEMETER_LOG_LEVEL=INFO

# ── Backend WebSocket ─────────────────────────────────────────────────────────
# Producción (túnel Cloudflare activo en el laptop/servidor):
DEMETER_BACKEND_URL=patata.monters.org
DEMETER_BACKEND_PORT=443

# Local (backend corriendo en la misma red, sin túnel — p.ej. en el laptop):
# DEMETER_BACKEND_URL=192.168.1.XXX   ← IP local del laptop/servidor
# DEMETER_BACKEND_PORT=8001

# ── UART / Hardware ───────────────────────────────────────────────────────────
# GPIO serie de la Raspberry Pi (pines 8 y 10):
HOST_SERIAL_PORT=/dev/serial0
DEMETER_PORT=/dev/ttyS0

# Si usas un adaptador USB-Serie:
# HOST_SERIAL_PORT=/dev/ttyUSB0
# DEMETER_PORT=/dev/ttyUSB0

DEMETER_UART_BAUD=115200
