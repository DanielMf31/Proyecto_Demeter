# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.prod)
# ==========================================
# Rename to .env for the Production environment

# --- API Configuration ---
DEMETER_ENV=production
API_PREFIX=/api
# Critically important to keep False for performance and security
DEBUG=False

# --- Database Credentials (Production) ---
DEMETER_POSTGRES_USER=demeter_prod_user
# CHANGE THIS TO A STRONG PASSWORD IN PRODUCTION
DEMETER_POSTGRES_PASSWORD=super_secure_prod_password_change_me
DEMETER_POSTGRES_DB=demeter_prod

# --- Raspberry Pi Hardware ---
SERIAL_PORT_HOST=/dev/serial0

# --- Frontend Settings ---
# Example: patata.monters.org
VITE_API_URL=https://patata.monters.org/api
VITE_WS_URL=wss://patata.monters.org/ws
