# General
__pycache__/
*.py[cod]
*$py.class
*.log
*.sqlite
*.db

# Environment variables
# Ningún fichero de entorno se versiona salvo la plantilla .env.example.
# Motivo: la auditoría de cierre encontró un token de Cloudflare vivo en
# .env.staging (ver docs/Closure, Anexo B).
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

