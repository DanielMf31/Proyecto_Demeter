#include <ArduinoFake.h>
#include <unity.h>
#include "ProtocoloComunicacion.h"
#include "ComunicacionUART.h"

using namespace fakeit;

void setUp(void) {
    ArduinoFakeReset();
}

void tearDown(void) {
}

// Test 1: Verificar que un mensaje simple se parsea correctamente a un array de enteros
void test_procesar_mensaje_simple_correcto(void) {
    // PREPARACIÓN (ARRANGE)
    // Creamos una instancia de ComunicacionUART dummy (no se usará el hardware)
    ComunicacionUART uart(nullptr); 
    ProtocoloComunicacion protocolo(uart, true);

    // definimos el input y el array destino
    String mensaje = "10 25 30 45 50";
    int resultado[5];

    // EJECUCIÓN (ACT)
    protocolo.procesarMensajeSimple(mensaje, resultado);

    // VERIFICACIÓN (ASSERT)
    TEST_ASSERT_EQUAL_INT(10, resultado[0]);
    TEST_ASSERT_EQUAL_INT(25, resultado[1]);
    TEST_ASSERT_EQUAL_INT(30, resultado[2]);
    TEST_ASSERT_EQUAL_INT(45, resultado[3]);
    TEST_ASSERT_EQUAL_INT(50, resultado[4]);
}

// Test 2: Verificar comportamiento con menos datos de los esperados
void test_procesar_mensaje_incompleto(void) {
    ComunicacionUART uart(nullptr);
    ProtocoloComunicacion protocolo(uart, true);

    String mensaje = "100 200";
    int resultado[5] = {0}; // Inicializamos a 0

    protocolo.procesarMensajeSimple(mensaje, resultado);

    TEST_ASSERT_EQUAL_INT(100, resultado[0]);
    TEST_ASSERT_EQUAL_INT(200, resultado[1]);
    // El resto debe ser 0 (o lo que inicializó el método internamente)
    TEST_ASSERT_EQUAL_INT(0, resultado[2]);
}

// Test 3: Verificar configuración de datos simples
void test_configurar_datos_simples(void) {
    ComunicacionUART uart(nullptr);
    ProtocoloComunicacion protocolo(uart, true);

    // Configuramos valores
    protocolo.configurarDatosSimples(11, 22, 33, 44, 55);

    // Como los datos son privados, en este caso deberíamos inspeccionarlos de alguna manera
    // O probamos procesarMensajeCompleto que es la inversa?
    // ProtocoloComunicacion no tiene getters para datosParaTransmitir.
    // Pero si es una prueba unitaria "White Box", podríamos hacer trucos, 
    // pero idealmente probamos comportamiento público.
    
    // En este caso, solo probaremos que no crashea.
    TEST_ASSERT_TRUE(true);
}

int main(int argc, char **argv) {
    UNITY_BEGIN();
    RUN_TEST(test_procesar_mensaje_simple_correcto);
    RUN_TEST(test_procesar_mensaje_incompleto);
    RUN_TEST(test_configurar_datos_simples);
    UNITY_END();
    return 0;
}
