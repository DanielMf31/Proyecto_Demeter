# ==========================================
# STAGING ENVIRONMENT CONFIGURATION (.staging)
# ==========================================
# Rename to .env for the Staging environment

# --- API Configuration ---
DEMETER_ENV=staging
API_PREFIX=/api
# Debug False to match production behavior
DEBUG=False

# --- Database Credentials (Staging) ---
DEMETER_POSTGRES_USER=demeter_stage_user
DEMETER_POSTGRES_PASSWORD=secure_staging_password_123
DEMETER_POSTGRES_DB=demeter_staging

# --- Raspberry Pi Hardware ---
SERIAL_PORT_HOST=/dev/serial0

# --- Frontend Settings ---
# Example: test.patata.monters.org
VITE_API_URL=https://test.patata.monters.org/api
VITE_WS_URL=wss://test.patata.monters.org/ws
