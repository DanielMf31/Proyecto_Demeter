# ==========================================
# STAGING ENVIRONMENT — patata.monters.org
# ==========================================
# Despliegue en portátil accesible via Cloudflare Tunnel
# Usar con: make staging
#
# IMPORTANTE: El túnel de Cloudflare debe estar activo en el portátil
# apuntando a los puertos de staging (ver Makefile → make tunnel-staging)

# --- Cloudflare Tunnel ---
# Token del túnel para staging → patata.monters.org
# Obtener en: dash.cloudflare.com → Zero Trust → Networks → Tunnels → tu túnel → Configure → Token
CLOUDFLARE_TUNNEL_TOKEN=PEGA_AQUI_TU_TOKEN

# --- Sistema ---
DEMETER_ENV=staging
DEBUG=True
API_PREFIX=/api

# --- Base de datos (Staging) ---
# Volumen aislado: postgres_staging (no mezcla datos con dev)
DEMETER_POSTGRES_USER=postgres
DEMETER_POSTGRES_PASSWORD=postgres_local_pass
DEMETER_POSTGRES_DB=demeter_staging
DEMETER_POSTGRES_SERVER=demeter-db
DEMETER_POSTGRES_PORT=5432

# --- Redis ---
DEMETER_REDIS_URL=redis://demeter-redis:6379/0
RQ_REDIS_URL=redis://demeter-redis:6379/1

# --- Hardware (deshabilitado en portátil) ---
SERIAL_PORT_HOST=/dev/ttyS0

# --- Frontend — apunta a Cloudflare Tunnel → patata.monters.org ---
VITE_API_URL=https://patata.monters.org/api
VITE_WS_URL=wss://patata.monters.org/ws

# --- Logging ---
DEMETER_LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
