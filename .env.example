# ─────────────────────────────────────────────────────────────────────────────
# PROYECTO DEMETER - UNIFIED CONFIGURATION
# SINGLE ENTRY POINT FOR ALL SERVICES
# ─────────────────────────────────────────────────────────────────────────────

# --- System ---
DEMETER_ENV=production
DEMETER_DEBUG=False
DEMETER_APP_NAME="Demeter IoT System"

# --- API & Networking ---
DEMETER_HOST=0.0.0.0
DEMETER_SOCKET_PORT=8000
DEMETER_API_PREFIX="/api"

# --- Backend Connectivity (for Raspberry) ---
# When running in Docker, the Raspberry needs to know where the Server is.
DEMETER_BACKEND_URL=patata.monters.org
DEMETER_BACKEND_PORT=80

# --- Redis ---
DEMETER_REDIS_URL=redis://redis:6379/0

# --- Database (Backend Postgres) ---
DEMETER_POSTGRES_USER=postgres
DEMETER_POSTGRES_PASSWORD=password
DEMETER_POSTGRES_SERVER=db
DEMETER_POSTGRES_PORT=5432
DEMETER_POSTGRES_DB=demeter_db

# --- Database (Raspberry SQLite) ---
DEMETER_DB_NAME=demeter_local.db

# --- Hardware (Raspberry) ---
DEMETER_PORT=/dev/serial0
DEMETER_UART_BAUD=115200

# --- Infrastructure ---
SERIAL_PORT_HOST=/dev/ttyS0
PYTHONUNBUFFERED=1
DEMETER_LOG_LEVEL=INFO
